[Unit]
Description=PostgreSQL Central Database
# Requires=postgres.socket
After=multi-user.target
Restart=always

[Service]
ExecStartPre=systemd-tmpfiles --create --prefix=/tmp/borgmatic

[Container]
Image=docker.io/pgvector/pgvector:pg17
# Image=docker.io/postgres:17
AutoUpdate=registry

# UserNS=keep-id:uid=999,gid=999
User=2500:2500
# UIDMap=999:2500

Pod=central-db.pod
# PublishPort=5432:5432

Volume=/var/home/db/appdata/postgres/data:/var/lib/postgresql/data:z
Volume=/run/postgres:/var/run/postgresql:z,rshared

Environment=POSTGRES_USER=admin
Secret=central_db_postgres_admin,type=env,target=POSTGRES_PASSWORD

HealthCmd=pg_isready -d postgres -U admin
HealthStartupInterval=20s
HealthInterval=30s
HealthTimeout=3s
HealthRetries=5
HealthStartPeriod=20s

[Service]
Restart=always
TimeoutSec=600

[Install]
WantedBy=multi-user.target