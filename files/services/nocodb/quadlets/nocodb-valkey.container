[Unit]
Description=NocoDB Valkey Cache
After=network-online.target

[Container]
ContainerName=
Image=docker.io/valkey/valkey:8-alpine
Exec=valkey-server --save 30 1 --loglevel warning --maxmemory 512mb --maxmemory-policy allkeys-lru
Pod=nocodb.pod
User={{ uid }}:{{ gid }}
Volume=%h/appdata/nocodb/valkey:/data:z

PodmanArgs=--memory=1024M
HealthCmd=valkey-cli ping | grep PONG
HealthStartupInterval=20s
HealthInterval=30s
HealthTimeout=3s
HealthRetries=5
HealthStartPeriod=20s

[Service]
Restart=always
TimeoutSec=600

[Install]
WantedBy=default.target